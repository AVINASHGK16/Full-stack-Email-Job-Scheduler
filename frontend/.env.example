# ── Frontend Environment Variables ─────────────────────────────
# Copy this file to .env and configure for your deployment environment.
# Variables must be prefixed with VITE_ to be exposed to Vite client code.

# Backend API Base URL
# Development: http://localhost:5000 (Vite proxy forwards automatically)
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:5000
