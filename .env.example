# ── Server Configuration ───────────────────────────────────────
PORT=5000
NODE_ENV=development # development | production | test

# ── PostgreSQL Database (Prisma) ──────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=scheduler_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheduler_db?schema=public

# ── Redis (BullMQ Queue & Shared Rate Limiting) ───────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Worker & Job Scheduling Configuration ─────────────────────
WORKER_CONCURRENCY=1
PENDING_RECOVERY_THRESHOLD_MS=30000
EMAIL_JOB_ATTEMPTS=3

# ── Google OAuth 2.0 & Frontend Configuration ─────────────────
JWT_SECRET=your_super_secret_jwt_and_session_signing_key_32chars_min
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ── Ethereal / SMTP Fallback Transport ────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASSWORD=your_ethereal_password